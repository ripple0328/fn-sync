#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
plugin_dir=$(CDPATH='' cd -- "$script_dir/.." && pwd)
case "$(uname -m)" in
  x86_64|amd64) runtime_arch=amd64 ;;
  aarch64|arm64) runtime_arch=arm64 ;;
  *) runtime_arch=unsupported ;;
esac
bundled_binary="$plugin_dir/runtime/bin/fn-sync-runtime-$runtime_arch"
bundled_client="$plugin_dir/runtime/fnsync.py"
service_source="$plugin_dir/runtime/fnsync.service"
service_unit_name="community.fnos-sync.service"
service_owner_marker="# Managed by community.fnos-sync"
plugin_version=$(sed -n 's/.*"version":[[:space:]]*"\([^"]*\)".*/\1/p' "$plugin_dir/manifest.json" | sed -n '1p')
service_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/fn-sync"
service_version_file="$service_state_dir/plugin-service-version"
managed_runtime_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fn-sync/runtime"
managed_rclone="$managed_runtime_dir/rclone"
rclone_release="1.75.0"
rclone_binary=""

rclone_supported() {
  [ -x "${1:-}" ] || return 1
  version=$("$1" version 2>/dev/null | sed -n 's/^rclone v\([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p; /rclone v[0-9]/q')
  [ -n "$version" ] || return 1
  major=${version%% *}
  minor=${version#* }
  [ "$major" -gt 1 ] || { [ "$major" -eq 1 ] && [ "$minor" -ge 66 ]; }
}

select_rclone() {
  rclone_binary=""
  system_rclone=$(command -v rclone 2>/dev/null || true)
  if rclone_supported "$system_rclone"; then
    rclone_binary="$system_rclone"
  elif [ ! -L "$managed_rclone" ] && rclone_supported "$managed_rclone"; then
    rclone_binary="$managed_rclone"
  fi
  if [ -n "$rclone_binary" ]; then
    FNSYNC_RCLONE="$rclone_binary"
    export FNSYNC_RCLONE
  else
    unset FNSYNC_RCLONE
  fi
}

install_managed_rclone() (
  case "$(uname -m)" in
    x86_64|amd64)
      archive_arch=amd64
      expected_sha256=aa2804e08f48250e71009c727124b6341cd0288465804a9a09d14663cabafbaa
      ;;
    aarch64|arm64)
      archive_arch=arm64
      expected_sha256=d0ad88ba4c8e285b7c9efa591e0ab643280a91741e13c27f3a9c0957ccfa5203
      ;;
    *)
      echo "FN Sync does not have a managed rclone build for $(uname -m)" >&2
      exit 1
      ;;
  esac

  for command_name in curl bsdtar sha256sum; do
    command -v "$command_name" >/dev/null 2>&1 || {
      echo "$command_name is required to prepare FN Sync's private rclone runtime" >&2
      exit 1
    }
  done

  archive="rclone-v${rclone_release}-linux-${archive_arch}.zip"
  url="https://downloads.rclone.org/v${rclone_release}/${archive}"
  temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/fn-sync-rclone.XXXXXX")
  trap 'rm -rf -- "$temp_dir"' EXIT INT TERM

  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
    --connect-timeout 15 --max-time 300 --max-filesize 67108864 \
    --output "$temp_dir/$archive" "$url"
  [ "$(wc -c < "$temp_dir/$archive")" -le 67108864 ] || {
    echo "The downloaded rclone archive exceeded the 64 MiB limit" >&2
    exit 1
  }
  actual_sha256=$(sha256sum "$temp_dir/$archive" | awk '{print $1}')
  if [ "$actual_sha256" != "$expected_sha256" ]; then
    echo "The downloaded rclone archive failed its pinned SHA-256 check" >&2
    exit 1
  fi

  bsdtar -xf "$temp_dir/$archive" -C "$temp_dir"
  extracted="$temp_dir/rclone-v${rclone_release}-linux-${archive_arch}/rclone"
  [ -f "$extracted" ] || {
    echo "The downloaded rclone archive did not contain the expected executable" >&2
    exit 1
  }
  mkdir -p "$managed_runtime_dir"
  [ ! -L "$managed_rclone" ] || {
    echo "Refusing to replace a symbolic-link private rclone runtime" >&2
    exit 1
  }
  install -m 0755 "$extracted" "$managed_rclone"
  rclone_supported "$managed_rclone" || {
    echo "The prepared rclone executable could not be verified" >&2
    exit 1
  }
)

select_rclone

client="${FNSYNC_BIN:-}"
client_mode="command"
client_distribution=system
if [ -n "$client" ] && [ ! -x "$client" ]; then
  client=""
fi
if [ -z "$client" ] && [ -x "$bundled_binary" ]; then
  client="$bundled_binary"
  client_mode=binary
  client_distribution=plugin
fi
if [ -z "$client" ] && [ -f "$bundled_client" ]; then
  client="$bundled_client"
  client_mode=python
  client_distribution=plugin
fi
if [ -z "$client" ] && [ -x "$HOME/.local/bin/fn-sync" ]; then
  client="$HOME/.local/bin/fn-sync"
fi
if [ -z "$client" ]; then
  client=$(command -v fn-sync || true)
fi
if [ -z "$client" ]; then
  client=$(command -v fnsync || true)
fi

run_client() {
  if [ "$client_mode" = python ]; then
    python3 "$client" "$@"
  else
    "$client" "$@"
  fi
}

exec_client() {
  if [ "$client_mode" = python ]; then
    exec python3 "$client" "$@"
  else
    exec "$client" "$@"
  fi
}

missing_dependencies() {
  missing=""
  if [ "$client_mode" = python ]; then
    command -v python3 >/dev/null 2>&1 || missing="python"
  fi
  [ -n "$rclone_binary" ] || missing="${missing:+$missing,}rclone"
  printf '%s' "$missing"
}

ensure_service() {
  [ -f "$service_source" ] || return 0
  unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  unit="$unit_dir/$service_unit_name"
  legacy_unit="$unit_dir/fnsync.service"
  unit_changed=0
  mkdir -p "$unit_dir"
  # Versions before 0.10.3 used a generic unit name. Remove it only when both
  # exact signatures prove that it was created by this plugin.
  if [ -f "$legacy_unit" ] && [ ! -L "$legacy_unit" ] \
    && grep -Fqx 'Description=FN Sync background service for the Omarchy plugin' "$legacy_unit" \
    && grep -Fqx 'ExecStart=%h/.config/omarchy/plugins/community.fnos-sync/scripts/fn-syncctl daemon' "$legacy_unit"; then
    systemctl --user disable --now fnsync.service >/dev/null 2>&1 || true
    rm -f -- "$legacy_unit"
    systemctl --user daemon-reload
  fi
  if [ -L "$unit" ]; then
    echo "Refusing to replace symbolic-link service unit: $unit" >&2
    return 4
  fi
  if [ -e "$unit" ] && ! grep -Fqx "$service_owner_marker" "$unit"; then
    echo "Refusing to replace a service unit not owned by the FN Sync plugin: $unit" >&2
    return 4
  fi
  if [ ! -f "$unit" ] || ! cmp -s "$service_source" "$unit"; then
    install -m 0644 "$service_source" "$unit"
    systemctl --user daemon-reload
    unit_changed=1
  fi
  if ! systemctl --user is-enabled --quiet "$service_unit_name" 2>/dev/null \
    || ! systemctl --user is-active --quiet "$service_unit_name" 2>/dev/null; then
    systemctl --user enable --now "$service_unit_name" >/dev/null
  elif [ "$unit_changed" -eq 1 ] || {
    [ -n "$plugin_version" ] \
      && [ "$(sed -n '1p' "$service_version_file" 2>/dev/null || true)" != "$plugin_version" ]
  }; then
    systemctl --user restart "$service_unit_name"
  fi
}

record_service_version() {
  [ -n "$plugin_version" ] || return 0
  mkdir -p "$service_state_dir"
  [ ! -L "$service_version_file" ] || {
    echo "Refusing to replace a symbolic-link service version file" >&2
    return 4
  }
  version_temp=$(mktemp "$service_state_dir/.plugin-service-version.XXXXXX")
  printf '%s\n' "$plugin_version" > "$version_temp"
  chmod 0600 "$version_temp"
  mv -f -- "$version_temp" "$service_version_file"
}

bootstrap() {
  [ -n "$client" ] || {
    echo "FN Sync runtime is missing" >&2
    return 2
  }
  missing=$(missing_dependencies)
  [ -z "$missing" ] || {
    echo "Missing runtime dependencies: $missing" >&2
    return 3
  }
  ensure_service
}

case "${1:-status}" in
  status)
    if [ -z "$client" ]; then
      printf '%s\n' '{"installed":false,"tasks":[],"connections":[],"error":"fn-sync is not installed"}'
      exit 0
    fi
    language="${2:-system}"
    missing=$(missing_dependencies)
    if [ -n "$missing" ]; then
      printf '{"installed":true,"ready":false,"distribution":"%s","missing_dependencies":"%s","tasks":[],"connections":[],"error":""}\n' \
        "$client_distribution" "$missing"
      exit 0
    fi
    # The Omarchy plugin installer cannot run lifecycle hooks. Status refreshes
    # are guaranteed for an enabled bar widget, so use them as a second,
    # idempotent bootstrap path if the one-shot QML timer is skipped during a
    # live plugin reload.
    ensure_service
    FNSYNC_LANGUAGE="$language" exec_client plugin-status --distribution "$client_distribution"
    ;;
  bootstrap)
    bootstrap
    ;;
  install-dependencies)
    language="${2:-system}"
    if [ "$client_mode" = python ] && ! command -v python3 >/dev/null 2>&1; then
      echo "This source-checkout fallback needs Python; install the published standalone plugin instead" >&2
      exit 1
    fi
    if [ -z "$rclone_binary" ]; then
      install_managed_rclone
      select_rclone
    fi
    bootstrap
    ;;
  sync)
    [ -n "$client" ] || { echo "fn-sync is not installed" >&2; exit 1; }
    language="${2:-system}"
    shift 2 || true
    FNSYNC_LANGUAGE="$language" exec_client sync-now
    ;;
  discover)
    if [ "$client_mode" = binary ]; then
      exec_client plugin-discover
    fi
    exec python3 "$script_dir/fn_sync_discover.py"
    ;;
  cli)
    [ -n "$client" ] || { echo "fn-sync is not installed" >&2; exit 1; }
    shift
    language="${1:-system}"
    shift || true
    [ "$#" -gt 0 ] || { echo "fn-syncctl cli requires a command" >&2; exit 2; }
    FNSYNC_LANGUAGE="$language" FNSYNC_STREAM_OUTPUT=1 exec_client "$@"
    ;;
  client)
    [ -n "$client" ] || { echo "fn-sync is not installed" >&2; exit 1; }
    shift
    exec_client "$@"
    ;;
  daemon)
    [ -n "$client" ] || { echo "fn-sync is not installed" >&2; exit 1; }
    record_service_version
    exec_client daemon
    ;;
  *)
    echo "usage: fn-syncctl [status|bootstrap|install-dependencies|sync|discover|cli ...|client ...|daemon]" >&2
    exit 2
    ;;
esac
