{
  "schemaVersion": 1,
  "id": "community.fnos-sync",
  "name": "FN sync",
  "version": "0.8.1",
  "author": "Qingbo Zhang",
  "license": "MIT",
  "description": "Theme-native FN sync task management for the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "FN sync",
    "description": "Authorize fnOS NAS connections once, then create and monitor multiple sync tasks.",
    "category": "Files",
    "aliases": [
      "fn-sync",
      "fn",
      "fnos",
      "nas",
      "sync"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "language": "system"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 600,
        "step": 10,
        "defaultValue": 30
      },
      {
        "key": "language",
        "type": "enum",
        "label": "Language",
        "description": "Follow the desktop language by default.",
        "defaultValue": "system",
        "options": [
          {
            "value": "system",
            "label": "System default"
          },
          {
            "value": "en",
            "label": "English"
          },
          {
            "value": "zh",
            "label": "简体中文"
          }
        ]
      }
    ]
  }
}
